    <datatype>text</datatype>
    <initialvalue xml:space="preserve">-- Recalcular % FOJA y Metas de Gestión según parámetros globales vigentes en SQL Server
UPDATE dotacion_asistencial
SET
    foja_pct = CASE WHEN hs_dic &gt; 0 THEN ROUND(pct_directo_final_p2 * 100.0, 2) ELSE 0.0 END,
    updated_at = CURRENT_TIMESTAMP;

INSERT INTO auditoria_cambios (
    version_id, actor, tipo_evento, entidad_afectada, campo_modificado,
    valor_anterior, valor_nuevo, mes_inicio_vigencia, impacto_atenciones_anual,
    justificacion, estado_aprobacion
) VALUES (
    1, 'Bot Blue Prism (02_Carga_y_Calculo_Planificacion)', 'SINCRONIZACION_PLANIFICACION',
    'Dotación Asistencial + Excepciones + LOP + Distribucion_NAC',
    'Recálculo Nacional 17 Institutos', 'Planilla Excel',
    (SELECT CONCAT(CONVERT(NVARCHAR(30), COUNT(*)), N' filas sincronizadas en SQL Server') FROM dotacion_asistencial),
    1, (SELECT CAST(SUM(mg_anual_total) AS INT) FROM dotacion_asistencial),
    'Lectura de hojas vía MS Excel VBO - Extended y persistencia en Data - MSSQLLocalDB', 'APROBADO'
);</initialvalue>
