    foja_pct = CASE WHEN hs_dic &gt; 0 THEN ROUND(pct_directo_final_p2 * 100.0, 2) ELSE 0.0 END,
    updated_at = CURRENT_TIMESTAMP;

INSERT INTO auditoria_cambios (
